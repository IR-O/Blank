{
  "name": "Chizuru Music Bot",
  "description": "Telegram Voice Chat Music Player",
  "logo": "https://graph.org/file/e3fa9ab16ebefbfdd29d9.jpg",
  "keywords": ["music", "voicechat", "telegram"],
  "repository": "https://github.com/yourusername/ChizuruMusic",
  "env": {
    "API_ID": {
      "description": "Your Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Your Telegram API Hash from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Your Bot Token from @BotFather",
      "required": true
    },
    "ASSISTANT_SESSION": {
      "description": "Assistant Session String",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram User ID",
      "required": true
    }
  },
  "buildpacks": [
    {"url": "heroku/python"},
    {"url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest.git"}
  ]
}
